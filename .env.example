# Copy this file to .env.local (gitignored, matches *.local).
#
# Note what is NOT here any more: VITE_MODERATOR_PASSCODE. Anything prefixed
# VITE_ is inlined into the client bundle at build time, so that passcode was
# readable by every visitor and the "is moderator" flag it set was just a
# localStorage boolean. Admin access is now checked on the server, and none of
# the variables below are VITE_-prefixed — they must never become so.

# --- Database (Neon Postgres) ---------------------------------------------
# Install the Neon integration on the Vercel project, then run
#   vercel env pull .env.local
# to fetch this automatically. Holds the archive corpus, the publication map,
# the live-page backup and the shared glyph atlas.
DATABASE_URL=

# --- Admin access ----------------------------------------------------------
# The password for /moderator and /manage. Choose something long; there is one
# operator and no rate limiting.
ADMIN_PASSWORD=

# Signs the session cookie. Any long random string — e.g.
#   openssl rand -hex 32
# Changing it signs everyone out, which is also how you revoke a session.
SESSION_SECRET=

# --- Scheduled backup (optional) -------------------------------------------
# Set this on Vercel and it will send `Authorization: Bearer <value>` with the
# cron request to /api/snapshot. Without it the scheduled call is refused, which
# is deliberate: an unauthenticated snapshot endpoint would be writable by
# anyone. Not needed for local development.
CRON_SECRET=
