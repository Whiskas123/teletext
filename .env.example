# Copy this file to .env.local (gitignored, matches *.local) and set your own
# passcode. It gates the /moderator sign-in — see src/collab/moderator.ts.
#
# There's no backend, so this is NOT real security: it's baked into the
# client bundle and readable by anyone who inspects it. It only prevents
# accidental edits to the archive (pages 100-699), not a determined bypass.
VITE_MODERATOR_PASSCODE=temporary_passcode
