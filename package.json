{
  "name": "teletext-workshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun run scripts/prerender.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "bun run --env-file=.env.local scripts/migrate.ts",
    "db:import-corpus": "bun run --env-file=.env.local scripts/importCorpus.ts",
    "db:import-seed": "bun run --env-file=.env.local scripts/importSeedPages.ts",
    "db:backfill-images": "bun run --env-file=.env.local scripts/backfillImages.ts",
    "db:restore": "bun run --env-file=.env.local scripts/restoreFromSnapshot.ts",
    "db:verify-decoder": "bun run scripts/verifyDecoder.ts",
    "room:migrate": "bun run scripts/migrateRoom.ts",
    "og:image": "bun run scripts/makeOgImage.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@playhtml/react": "^2.0.1",
    "@vercel/analytics": "^2.0.1",
    "playhtml": "^2.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.9.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
